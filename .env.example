# Copy to .env (next to docker-compose.yml) or to server/.env when running with plain Node.
# Generate tokens with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Shared by every teammate: the Claude Code installer and the Chrome extension use it to upload.
TEAM_TOKEN=

# For the manager only: opens the dashboard and the admin tools (alerts settings, renaming
# and deleting members). Leave it empty and the team token opens the dashboard, with the
# admin tools turned off.
DASHBOARD_TOKEN=

# Optional when running with plain Node:
# PORT=8787
# HOST=0.0.0.0
# DB_PATH=./data/usage.db
