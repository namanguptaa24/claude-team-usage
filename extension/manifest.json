{
  "manifest_version": 3,
  "name": "Claude Team Usage",
  "version": "1.1.0",
  "description": "Reports which team member uses the shared Claude limit on claude.ai, and on which model, to your team's usage server.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "alarms", "identity", "identity.email"],
  "host_permissions": ["https://claude.ai/*"],
  "storage": { "managed_schema": "managed_schema.json" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["sse.js", "inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Claude Team Usage",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
